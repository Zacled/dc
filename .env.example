# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# Never commit your real .env — it contains your bot token.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your server (guild) ID. Right-click your server -> Copy Server ID
# (enable Developer Mode in Discord settings first).
GUILD_ID=

# The Discord user ID that gets PINGED when a payment is detected (that's you).
OWNER_ID=

# Optional: a staff role ID that should also be able to see every ticket.
# Leave as 0 if you don't have one.
STAFF_ROLE_ID=0

# Optional: a category ID to create ticket channels under. Leave 0 to create
# them at the top level of the server.
TICKET_CATEGORY_ID=0

# --- Product ---------------------------------------------------------------
PRODUCT_NAME=My Product
PRODUCT_PRICE_USD=10

# How long (minutes) an unpaid order stays open before it expires.
ORDER_EXPIRY_MINUTES=30

# How often (seconds) the bot scans the blockchains for payments.
POLL_INTERVAL_SECONDS=45

# Where to store the SQLite order log. On Railway, attach a Volume and set this
# to a path inside it (e.g. /data/orders.db) so orders survive redeploys.
DATABASE_PATH=orders.db

# --- Receiving addresses ---------------------------------------------------
# Put YOUR wallet addresses here. Leave a coin blank to disable that button.
LTC_ADDRESS=
SOL_ADDRESS=
ETH_ADDRESS=

# How many confirmations before the bot considers a payment final.
LTC_MIN_CONFIRMATIONS=1
ETH_MIN_CONFIRMATIONS=2
SOL_MIN_CONFIRMATIONS=1

# --- Stablecoins (USDT / USDC) ---------------------------------------------
# Each appears as a button that opens a network sub-menu. Set only the
# networks you want. Ethereum networks need an Etherscan key (see below).
# USDT on Tron (TRC-20). Your Tron (T...) receiving address.
USDT_TRON_ADDRESS=
USDT_TRON_MIN_CONFIRMATIONS=1
# USDT on Solana (SPL). Your Solana wallet address (can match SOL_ADDRESS).
USDT_SOL_ADDRESS=
USDT_SOL_MIN_CONFIRMATIONS=1
# USDC on Solana (SPL). Your Solana wallet address (can match SOL_ADDRESS).
USDC_SOL_ADDRESS=
USDC_SOL_MIN_CONFIRMATIONS=1
# USDC on Ethereum (ERC-20) — OPTIONAL, needs ETHERSCAN_API_KEY. Leave blank to skip.
USDC_ETH_ADDRESS=
USDC_ETH_MIN_CONFIRMATIONS=2

# --- Blockchain APIs -------------------------------------------------------
# Ethereum: get a free key at https://etherscan.io/apis (also used for USDC-ETH)
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1

# Tron (USDT): optional free API key from https://www.trongrid.io/ (raises limits)
TRONGRID_API_KEY=

# Litecoin: optional Blockcypher token (raises rate limits).
# Free token at https://www.blockcypher.com/
BLOCKCYPHER_TOKEN=

# Solana RPC. The public endpoint works for testing but is rate-limited and
# may block getSignaturesForAddress. For production use a free provider like
# Helius (https://helius.dev) or QuickNode and paste the full URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Price feed (CoinGecko free API — no key needed).
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# --- Key-sharing warnings --------------------------------------------------
# Your extension's Pantry ID (from the keygen/extension). The bot reads the
# wpbind basket to detect warnings, then DMs the buyer + posts in the channel.
PANTRY_ID=
WARNINGS_CHANNEL_NAME=warnings
WARNING_POLL_SECONDS=60
